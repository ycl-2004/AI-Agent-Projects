# ==============================================================================
# Model & API Configuration Template
# 复制本文件为 .env 并填入你自己的 API Key
# ==============================================================================

# 模型名称 (如 gpt-4o, gpt-4o-mini, claude-3-5-sonnet 等)
MODEL=gpt-4o

# OpenAI 兼容 API 基础端点
BASE_URL=https://api.openai.com/v1

# 你的 API Key
ZAI_API_KEY=sk-your-actual-api-key-here
